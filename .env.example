# Copia este ficheiro como .env (no servidor) e cambia os valores.
# O .env NON se sube ao repositorio.

DJANGO_DEBUG=False
# Xerar con: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambiame
# Dominios separados por comas
DJANGO_ALLOWED_HOSTS=usuario.pythonanywhere.com
DJANGO_SSL_REDIRECT=True
