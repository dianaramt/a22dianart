# Copia este ficheiro como .env e cambia os valores "cambiame". O .env NON se sube ao repositorio.

# --- Produción (PythonAnywhere) ---
DJANGO_DEBUG=False
# Xerar con: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambiame
DJANGO_ALLOWED_HOSTS=a22dianart.pythonanywhere.com
DJANGO_SSL_REDIRECT=True
# Só se usas `manage.py cargar_demo` no servidor
# BAMBI_DEMO_CONTRASINAL=cambiame

# --- Docker en local (docker compose up) ---
# Opcionais: sen elas o compose.yaml usa bambi / bambi / bambi-local.
# Non afectan a PythonAnywhere: Django só usa PostgreSQL se está definido POSTGRES_HOST, que pon o compose.
POSTGRES_DB=bambi
POSTGRES_USER=bambi
POSTGRES_PASSWORD=cambiame
